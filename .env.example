# Copy to .env (repo root) and edit. NEVER commit .env.
# Values below are LOCAL DEVELOPMENT ONLY.

APP_ENV=development
LOG_LEVEL=INFO
# "console" for development, "json" for production
LOG_FORMAT=console

# --- Database ---
# Used by docker-compose.yml
POSTGRES_USER=oars
POSTGRES_PASSWORD=oars_dev_password
POSTGRES_DB=oars
# Used by the backend (must use the psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://oars:oars_dev_password@localhost:5432/oars

# --- Auth ---
# REQUIRED, at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- HTTP ---
# Comma-separated list of exact origins. Wildcards are rejected.
CORS_ORIGINS=http://localhost:5173

# --- Local object storage (MinIO, used from the storage phase) ---
MINIO_ROOT_USER=oars-minio
MINIO_ROOT_PASSWORD=oars_minio_dev_password

# --- Auth / cookies ---
# Base URL of the web app (used in email links).
PUBLIC_APP_URL=http://localhost:5173
# Production topology: web on app.example.com and API on api.example.com share a registrable
# domain, so SameSite=Lax cookies work. Leave unset in development.
# COOKIE_DOMAIN=.example.com
# Rate limits: attempts per window per account; per-IP limits are 5x this (campus NAT).
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Number of reverse proxies in front of the API that append to X-Forwarded-For. 0 = ignore the header.
TRUSTED_PROXY_COUNT=0

# --- File storage and uploads ---
STORAGE_BACKEND=local
# Local disk is for development only (default folder: <repo>/storage). Production MUST use s3.
# STORAGE_LOCAL_PATH=
MAX_UPLOAD_BYTES=26214400
DOWNLOAD_URL_TTL_SECONDS=60
# S3-compatible storage (AWS S3, Cloudflare R2, MinIO). Install the extra: pip install '.[s3]'
# STORAGE_BACKEND=s3
# S3_BUCKET=oars-files
# S3_ENDPOINT_URL=http://localhost:9000      # MinIO; create the bucket in the console first
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Printing and payments ---
# Only the development FakeProvider exists. In production online payment is DISABLED until a real
# provider is implemented (pay-on-pickup keeps working).
PAYMENT_PROVIDER=fake
PAYMENT_PENDING_MINUTES=30
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# Student documents are deleted this many days after an order is closed
PRINT_RETENTION_DAYS=30
PRINT_ORPHAN_UPLOAD_HOURS=24
MAX_PRINT_PAGES_PER_DOCUMENT=500
# Pay-on-pickup abuse controls
MAX_OUTSTANDING_PICKUP_ORDERS=2
MAX_PICKUP_ORDER_TOTAL_UGX=100000
MAX_ACTIVE_ORDERS_PER_STUDENT=10

# --- Notifications (Phase 11) ---
# No new environment variables required. Notifications are stored in PostgreSQL
# and processed synchronously within request lifecycles.
# In production, schedule POST /api/v1/notifications/process-outbox to run periodically
# (e.g. every 60 seconds) via a cron job or a managed scheduler.

# --- Email / SMTP ---
# Without SMTP_HOST the app prints verification links to the backend console (development only).
# Fill in your SMTP credentials to receive real emails.
#
# Gmail (App Password — requires 2-Step Verification at myaccount.google.com/apppasswords):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your.address@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_USE_TLS=true
# SMTP_FROM_ADDRESS=your.address@gmail.com
# SMTP_FROM_NAME=OARS Student Solutions

# --- Advertising (Phase 12) ---
# No new environment variables required. Ad lifecycle and analytics are database-backed.

